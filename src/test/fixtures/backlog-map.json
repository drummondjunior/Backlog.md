{
	"_doc": "Mapa central canon ↔ Backlog.md (nó 1.34.10.7). Fonte única: o conector (fork backlog-md-canon) e o node-edit leem daqui; nenhum dos dois guarda lista própria. Por repo, só o que muda, na chave 'backlog' do canon.config.json. Campo com 'canon': 'missing' é o que o canon ainda não tem — e tem de citar o nó que o desenvolve.",
	"folders": {
		"_doc": "Caminhos relativos à raiz do repo. kinds = por tipo de documento: standard = onde nasce; alternatives = onde também se procura; dirName = nome de pasta buscado em qualquer lugar; filePattern separa tipos que dividem pasta. Em excluded, '**' = qualquer subpasta.",
		"kinds": {
			"plans": { "standard": "docs/plans", "alternatives": ["docs/superpowers/plans"], "dirName": "plans" },
			"handoffs": {
				"standard": "docs/plans",
				"alternatives": ["docs/superpowers/plans"],
				"dirName": "plans",
				"filePattern": "^HANDOFF-.*\\.md$"
			},
			"specs": {
				"standard": "docs/specs",
				"alternatives": ["docs/superpowers/specs", ".claude/specs"],
				"dirName": "specs"
			},
			"architecture": { "standard": "docs/architecture", "alternatives": [], "dirName": "architecture" }
		},
		"excluded": ["**/_backup/**", "**/*-backlog/**", "**/*-canon/**"],
		"decisionFileNames": ["^ADR-\\d+", "^ASR-\\d+", "decis"]
	},
	"statuses": {
		"_doc": "Estado do canon → coluna do Backlog.md (nome exibido) e grupo: board (quadro), completed (concluído), archived (arquivado), structural (não é tarefa). Estado fora da lista aparece como 'Estado inválido', nunca escondido.",
		"CAPTURED": { "column": "Capturado", "group": "board", "draft": true },
		"TODO": { "column": "A fazer", "group": "board" },
		"DOING": { "column": "Em curso", "group": "board" },
		"BLOCKED": { "column": "Travado", "group": "board" },
		"VERIFY": { "column": "A verificar", "group": "board" },
		"ACTIVE": { "column": "Ativo", "group": "board" },
		"DEFERRED": { "column": "Adiado", "group": "board" },
		"DONE": { "column": "Entregue", "group": "board" },
		"REJECTED": { "column": "Recusado", "group": "archived" },
		"SUPERSEDED": { "column": "Substituído", "group": "archived" },
		"estrutural": { "column": null, "group": "structural" },
		"_invalid": { "column": "Estado inválido", "group": "board" }
	},
	"fields": {
		"_doc": "Campo do Backlog.md (nome no arquivo) → onde está no canon. 'canon': nome da chave existente no nó; 'same': grava com o mesmo nome (node-edit); 'derived': vem da árvore ou do git; 'missing': o canon ainda não tem → 'node' que desenvolve.",
		"id": { "canon": "id" },
		"title": { "canon": "derived", "from": "1ª frase do bloco ```canon" },
		"status": { "canon": "status", "via": "statuses" },
		"parent_task_id": { "canon": "parent" },
		"subtasks": { "canon": "derived", "from": "filhos na árvore" },
		"ordinal": { "canon": "derived", "from": "ordem Dewey" },
		"labels": { "canon": "kind", "plus": "labels" },
		"kind": {
			"canon": "same",
			"legacyKey": "tipo",
			"note": "natureza do nó (trabalho/estrutural/...); nó 1.44.6 — antes 'tipo', que colidia com o 'type' do Backlog.md"
		},
		"source": { "canon": "same", "legacyKey": "origem" },
		"session": { "canon": "same", "legacyKey": "sessao" },
		"sources": { "canon": "same", "legacyKey": "fontes" },
		"parity": { "canon": "same", "legacyKey": "paridade" },
		"design": { "canon": "same", "legacyKey": "desenho" },
		"system": { "canon": "same", "legacyKey": "sistema" },
		"created_date": { "canon": "same", "fallback": "gerado_em, depois 1º commit", "legacyKey": "gerado_em" },
		"updated_date": { "canon": "same" },
		"completed_date": { "canon": "same", "note": "o Backlog.md não tem; campo nosso, gravado no done" },
		"due_date": { "canon": "same" },
		"assignee": { "canon": "same" },
		"reporter": { "canon": "same" },
		"priority": { "canon": "same" },
		"type": { "canon": "same" },
		"project": { "canon": "same" },
		"milestone": {
			"canon": "same",
			"derivedDepth": 2,
			"note": "sem o campo, o marco é o ancestral com os 2 primeiros números do id (1.34.10.7 → 1.34); nó de 1 número fica sem. Decisão do Drummond 2026-09-19 (1.43)"
		},
		"dependencies": { "canon": "same", "plus": "aresta blocks" },
		"references": { "canon": "same", "plus": "design, review" },
		"documentation": { "canon": "same" },
		"modified_files": { "canon": "same" },
		"onStatusChange": { "canon": "same" },
		"branch": { "canon": "derived", "from": "git (o carregador deles lê)" },
		"description": {
			"canon": "same",
			"section": "## Description",
			"fallback": "resto do bloco ```canon depois do título"
		},
		"acceptance_criteria": { "canon": "same", "section": "## Acceptance Criteria" },
		"definition_of_done": { "canon": "same", "section": "## Definition of Done" },
		"implementation_plan": { "canon": "same", "section": "## Implementation Plan" },
		"implementation_notes": { "canon": "## Journal" },
		"final_summary": { "canon": "same", "section": "## Final Summary" },
		"comments": { "canon": "same", "section": "## Comments" }
	},
	"values": {
		"type": ["bug", "feature", "enhancement", "task", "chore", "docs", "spike"],
		"priority": ["high", "medium", "low"],
		"nodeTypes": ["trabalho", "estrutural", "correção", "investigação", "documentação", "followup"],
		"nodeTypeLegacy": { "correcao": "correção", "investigacao": "investigação", "documentacao": "documentação" }
	}
}
